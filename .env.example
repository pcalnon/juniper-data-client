# =============================================================================
# juniper-data-client Environment Variables
# Copy this file to .env and customize as needed.
# =============================================================================

# juniper-data service connection
JUNIPER_DATA_URL=http://localhost:8100
JUNIPER_DATA_API_KEY=

# Docker-secret indirection (optional). When set, the client reads the stripped
# file contents as the API key before JUNIPER_DATA_API_KEY. Constructor api_key=
# still wins over both. Unreadable or empty file falls through to the plain var.
# JUNIPER_DATA_API_KEY_FILE=/run/secrets/juniper_data_api_keys
